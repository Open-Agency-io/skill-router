{
  "name": "@openagency.io/skill-router",
  "version": "0.1.0",
  "description": "Low-token, harness-portable routing for agent skills",
  "type": "module",
  "bin": {
    "skill-router": "./src/cli.js"
  },
  "scripts": {
    "test": "node --test",
    "test:container": "node --test test/container-plan.test.js test/container-security.test.js test/container-lifecycle.test.js test/container-case.test.js",
    "check": "node scripts/check.mjs",
    "gate:clean": "node scripts/clean-candidate.mjs",
    "gate:release": "node scripts/release-dist.mjs",
    "test:opencode-e2e": "node scripts/opencode-e2e.mjs",
    "container:list": "node scripts/container-harness.mjs list",
    "container:plan": "node scripts/container-harness.mjs plan",
    "container:pack": "node scripts/container-harness.mjs pack",
    "container:build": "node scripts/container-harness.mjs build",
    "container:smoke": "node scripts/container-harness.mjs smoke",
    "container:auth-check": "node scripts/container-harness.mjs auth-check",
    "container:run": "node scripts/container-harness.mjs run",
    "validate:record": "bash scripts/record-validation.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "agent-skills",
    "opencode",
    "skill-router",
    "llm"
  ],
  "homepage": "https://github.com/Open-Agency-io/skill-router#readme",
  "bugs": {
    "url": "https://github.com/Open-Agency-io/skill-router/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Open-Agency-io/skill-router.git"
  },
  "license": "MIT",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  },
  "dependencies": {
    "yaml": "2.9.1"
  }
}
